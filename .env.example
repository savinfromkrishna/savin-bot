# Copy to .env. Everything here is optional; the app starts with an offline demo model.

# A model for the first account (you can also sign in to a model in Settings → Models).
# Any OpenAI-compatible server works, for example Ollama:
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_MODEL=qwen3:8b
# LLM_API_KEY=

# PORT=4310
# DATA_DIR=data

# Sessions are signed with a random secret kept in DATA_DIR; set one to share it between installs.
# BETTER_AUTH_SECRET=
# Another address the app is opened from, besides localhost and 127.0.0.1.
# WEB_ORIGIN=http://localhost:5173

# The bot browser: run without a window (servers), or use installed Chrome instead of
# the bundled Chromium (helps when a site refuses to sign in inside automated Chromium).
# BROWSER_HEADLESS=1
# BROWSER_CHANNEL=chrome

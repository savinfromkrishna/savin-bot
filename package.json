{
  "name": "savin-social",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,magenta \"node --import tsx scripts/dev-api.ts\" \"vite\"",
    "build": "vite build",
    "start": "cross-env NODE_ENV=production node --env-file-if-exists=.env --import tsx src/server/main.ts",
    "check": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "browser:install": "playwright install chromium",
    "app:start": "node --import tsx scripts/keep-running.ts start",
    "app:stop": "node --import tsx scripts/keep-running.ts stop",
    "app:status": "node --import tsx scripts/keep-running.ts status",
    "app:autostart": "node --import tsx scripts/keep-running.ts autostart",
    "app:no-autostart": "node --import tsx scripts/keep-running.ts no-autostart"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.87.1",
    "@hono/node-server": "2.1.5",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "@xyflow/react": "12.12.0",
    "better-auth": "1.7.10",
    "croner": "10.0.1",
    "ffmpeg-static": "5.3.0",
    "hono": "4.13.13",
    "lucide-react": "1.58.0",
    "node-pty": "1.1.0",
    "playwright": "1.64.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-markdown": "10.1.0",
    "react-router-dom": "7.18.4",
    "remark-gfm": "4.0.1",
    "tsx": "4.23.15",
    "ws": "8.22.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "6.1.2",
    "concurrently": "10.0.5",
    "cross-env": "10.1.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "4.1.11"
  },
  "pnpm": {
    "patchedDependencies": {
      "@earendil-works/pi-ai@0.87.1": "patches/@earendil-works__pi-ai@0.87.1.patch"
    }
  }
}
